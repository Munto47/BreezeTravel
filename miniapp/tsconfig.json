{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@breezetravel/trip-check-client": ["../packages/trip-check-client/src/index.ts"]
    },
    "types": ["@tarojs/taro", "node"]
  },
  "include": ["src", "config", "global.d.ts", "../packages/trip-check-client/src"]
}
