      "timeout_seconds": 600,
      "workdir": "backend"
    },
    {
      "argv": [
        "python",
        "-m",
        "pytest",
        "-q",
        "--ignore=tests/test_trip_nlu_v2_gate.py",
        "--timeout=180"
      ],
      "check_id": "backend.current_suite",
      "timeout_seconds": 3600,
      "workdir": "backend"
    },
    {
      "argv": [
        "python",
        "-m",
        "pytest",
        "-q",
        "tests/test_g05_city_knowledge_gate.py",
        "tests/test_g05_knowledge_provenance.py",
        "--timeout=180"
      ],
      "check_id": "g05.knowledge_provenance_expiry_gate",
      "timeout_seconds": 1800,
      "workdir": "backend"
    },
    {
      "argv": [
        "npm",
        "run",
        "typecheck"
      ],
      "check_id": "shared_client.typecheck",
      "timeout_seconds": 600,
      "workdir": "packages/trip-check-client"
    },
    {
      "argv": [
        "npm",
        "run",
        "build"
      ],
      "check_id": "shared_client.build",
      "timeout_seconds": 600,
      "workdir": "packages/trip-check-client"
    },
    {
      "argv": [
        "npm",
        "run",
        "build"
      ],
      "check_id": "frontend.production_build",
      "timeout_seconds": 1200,
      "workdir": "frontend"
    },
    {
      "argv": [
        "npm",
        "run",
        "test:e2e:city-knowledge"
