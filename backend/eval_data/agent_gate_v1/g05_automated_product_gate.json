      "check_id": "g05.browser_sourced_suggestions",
      "timeout_seconds": 1800,
      "workdir": "frontend"
    },
    {
      "argv": [
        "npm",
        "run",
        "typecheck"
      ],
      "check_id": "miniapp.typecheck",
      "timeout_seconds": 600,
      "workdir": "miniapp"
    },
    {
      "argv": [
        "npm",
        "run",
        "test"
      ],
      "check_id": "miniapp.tests",
      "timeout_seconds": 900,
      "workdir": "miniapp"
    },
    {
      "argv": [
        "npm",
        "run",
        "build:weapp"
      ],
      "check_id": "miniapp.production_build",
      "timeout_seconds": 1200,
      "workdir": "miniapp"
