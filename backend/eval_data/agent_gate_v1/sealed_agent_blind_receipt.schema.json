{
  "$defs": {
    "DetachedAuthoritySignature": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "ED25519",
          "default": "ED25519",
          "title": "Algorithm",
          "type": "string"
        },
        "authority_id": {
          "pattern": "^AUTH-[A-Z0-9-]{6,100}$",
          "title": "Authority Id",
          "type": "string"
        },
        "authority_role": {
          "enum": [
            "SEALED_CUSTODY",
            "AMAP_LIVE_EXPORTER",
            "QWEN_LIVE_EXPORTER",
            "AUTOMATED_PRODUCT_GATE",
            "LIVE_PROVIDER_GATE",
            "MULTI_AGENT_PANEL",
            "SEALED_AGENT_BLIND",
            "FINAL_GATE"
          ],
          "title": "Authority Role",
          "type": "string"
        },
        "signature_base64": {
          "maxLength": 100,
          "minLength": 80,
          "title": "Signature Base64",
          "type": "string"
        },
        "signed_payload_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Signed Payload Sha256",
          "type": "string"
        }
      },
      "required": [
        "authority_role",
        "authority_id",
        "signed_payload_sha256",
        "signature_base64"
      ],
      "title": "DetachedAuthoritySignature",
      "type": "object"
    },
    "TruthBundleCommitment": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "HMAC-SHA256",
          "default": "HMAC-SHA256",
          "title": "Algorithm",
          "type": "string"
        },
        "key_id": {
          "pattern": "^CUSTODY-[A-Z0-9-]{6,100}$",
          "title": "Key Id",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "key_id",
        "value"
      ],
      "title": "TruthBundleCommitment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "aggregate_metrics": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "integer"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "maxProperties": 100,
      "minProperties": 1,
      "title": "Aggregate Metrics",
      "type": "object"
    },
    "attempt_commitment_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Attempt Commitment Sha256",
      "type": "string"
    },
    "authority_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Authority Policy Sha256",
      "type": "string"
    },
    "authority_signature": {
      "$ref": "#/$defs/DetachedAuthoritySignature"
    },
    "blind_truth_returned_to_developer": {
      "const": false,
      "default": false,
      "title": "Blind Truth Returned To Developer",
      "type": "boolean"
    },
    "candidate_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Candidate Commit",
      "type": "string"
    },
    "candidate_tree": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Candidate Tree",
      "type": "string"
    },
    "case_set_commitment_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Case Set Commitment Sha256",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "custodian_task_id": {
      "maxLength": 160,
      "minLength": 8,
      "title": "Custodian Task Id",
      "type": "string"
    },
    "custody_registry_identity_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Custody Registry Identity Sha256",
      "type": "string"
    },
    "deterministic_score_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Deterministic Score Receipt Sha256",
      "type": "string"
    },
    "error_taxonomy": {
      "items": {
        "enum": [
          "WRONG_CITY",
          "WRONG_CATEGORY",
          "NON_ATOMIC_PLACE",
          "MENTION_FALSE_POSITIVE",
          "MENTION_FALSE_NEGATIVE",
          "DAY_ASSIGNMENT",
          "ROLE_CLASSIFICATION",
          "PROVIDER_RESOLUTION",
          "PUBLIC_LEAK",
          "LATENCY",
          "OTHER_AGGREGATED"
        ],
        "type": "string"
      },
      "title": "Error Taxonomy",
      "type": "array"
    },
    "evidence_level": {
      "const": "SEALED_AGENT_BLIND",
      "default": "SEALED_AGENT_BLIND",
      "title": "Evidence Level",
      "type": "string"
    },
    "goal_id": {
      "pattern": "^TC-[A-Z0-9-]+$",
      "title": "Goal Id",
      "type": "string"
    },
    "human_evidence": {
      "const": false,
      "default": false,
      "title": "Human Evidence",
      "type": "boolean"
    },
    "input_bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Bundle Sha256",
      "type": "string"
    },
    "mint_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Mint Receipt Sha256",
      "type": "string"
    },
    "model": {
      "const": "gpt-5.6-sol",
      "default": "gpt-5.6-sol",
      "title": "Model",
      "type": "string"
    },
    "one_shot_nonce_consumed": {
      "const": true,
      "default": true,
      "title": "One Shot Nonce Consumed",
      "type": "boolean"
    },
    "one_shot_nonce_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "One Shot Nonce Sha256",
      "type": "string"
    },
    "organizational_independence_claimed": {
      "const": false,
      "default": false,
      "title": "Organizational Independence Claimed",
      "type": "boolean"
    },
    "prediction_bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Prediction Bundle Sha256",
      "type": "string"
    },
    "process_isolation": {
      "const": true,
      "default": true,
      "title": "Process Isolation",
      "type": "boolean"
    },
    "prompt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Prompt Sha256",
      "type": "string"
    },
    "provider_binding_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Provider Binding Sha256",
      "type": "string"
    },
    "raw_truth_stored_in_repository": {
      "const": false,
      "default": false,
      "title": "Raw Truth Stored In Repository",
      "type": "boolean"
    },
    "reasoning_effort": {
      "const": "ultra",
      "default": "ultra",
      "title": "Reasoning Effort",
      "type": "string"
    },
    "required_gate_metrics_passed": {
      "title": "Required Gate Metrics Passed",
      "type": "boolean"
    },
    "schema_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Schema Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "sealed-agent-blind-receipt-v2",
      "default": "sealed-agent-blind-receipt-v2",
      "title": "Schema Version",
      "type": "string"
    },
    "score_input_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Score Input Manifest Sha256",
      "type": "string"
    },
    "scored_case_count": {
      "minimum": 1,
      "title": "Scored Case Count",
      "type": "integer"
    },
    "taxonomy_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "enum": [
          "WRONG_CITY",
          "WRONG_CATEGORY",
          "NON_ATOMIC_PLACE",
          "MENTION_FALSE_POSITIVE",
          "MENTION_FALSE_NEGATIVE",
          "DAY_ASSIGNMENT",
          "ROLE_CLASSIFICATION",
          "PROVIDER_RESOLUTION",
          "PUBLIC_LEAK",
          "LATENCY",
          "OTHER_AGGREGATED"
        ]
      },
      "title": "Taxonomy Counts",
      "type": "object"
    },
    "thresholds_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Thresholds Sha256",
      "type": "string"
    },
    "tranche_commitment_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Tranche Commitment Sha256",
      "type": "string"
    },
    "truth_bundle_commitment": {
      "$ref": "#/$defs/TruthBundleCommitment"
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "INCOMPLETE"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "required": [
    "goal_id",
    "candidate_commit",
    "candidate_tree",
    "tranche_commitment_sha256",
    "one_shot_nonce_sha256",
    "attempt_commitment_sha256",
    "custody_registry_identity_sha256",
    "authority_policy_sha256",
    "mint_receipt_sha256",
    "prompt_sha256",
    "schema_sha256",
    "thresholds_sha256",
    "config_sha256",
    "provider_binding_sha256",
    "deterministic_score_receipt_sha256",
    "score_input_manifest_sha256",
    "input_bundle_sha256",
    "prediction_bundle_sha256",
    "truth_bundle_commitment",
    "case_set_commitment_sha256",
    "scored_case_count",
    "custodian_task_id",
    "aggregate_metrics",
    "taxonomy_counts",
    "error_taxonomy",
    "required_gate_metrics_passed",
    "verdict",
    "completed_at",
    "authority_signature"
  ],
  "title": "SealedAgentBlindReceipt",
  "type": "object"
}
