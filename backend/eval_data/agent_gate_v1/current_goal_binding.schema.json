{
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "current-goal-binding-v2"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "mainline_phase",
          "work_package_registry_path"
        ]
      }
    }
  ],
  "properties": {
    "automated_gate_contract_path": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Automated Gate Contract Path",
      "type": "string"
    },
    "automated_gate_contract_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Automated Gate Contract Sha256",
      "type": "string"
    },
    "canonical_candidate_ref": {
      "const": "refs/heads/codex/trip-check-product-reset",
      "default": "refs/heads/codex/trip-check-product-reset",
      "title": "Canonical Candidate Ref",
      "type": "string"
    },
    "gate_profile": {
      "enum": [
        "CORE_AGENT_GATE",
        "HARDENED_CANDIDATE_GATE"
      ],
      "title": "Gate Profile",
      "type": "string"
    },
    "goal_id": {
      "pattern": "^TC-VNEXT-G0[1-7]-[A-Z0-9-]+$",
      "title": "Goal Id",
      "type": "string"
    },
    "goal_sequence": {
      "maximum": 7,
      "minimum": 1,
      "title": "Goal Sequence",
      "type": "integer"
    },
    "mainline_phase": {
      "anyOf": [
        {
          "enum": [
            "CORE_MVP",
            "PRODUCT_ENHANCEMENT",
            "CANDIDATE_HARDENING"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mainline Phase"
    },
    "predecessor_completion_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Predecessor Completion Commit",
      "type": "string"
    },
    "predecessor_goal_id": {
      "title": "Predecessor Goal Id",
      "type": "string"
    },
    "program_id": {
      "const": "TC-VNEXT-2026",
      "default": "TC-VNEXT-2026",
      "title": "Program Id",
      "type": "string"
    },
    "schema_version": {
      "default": "current-goal-binding-v1",
      "enum": [
        "current-goal-binding-v1",
        "current-goal-binding-v2"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "APPROVED",
        "IN_PROGRESS"
      ],
      "title": "Status",
      "type": "string"
    },
    "work_package_registry_path": {
      "anyOf": [
        {
          "const": "docs/governance/current_work_packages.json",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Work Package Registry Path"
    }
  },
  "required": [
    "goal_sequence",
    "goal_id",
    "status",
    "predecessor_goal_id",
    "predecessor_completion_commit",
    "automated_gate_contract_path",
    "automated_gate_contract_sha256",
    "gate_profile"
  ],
  "title": "CurrentGoalBinding",
  "type": "object"
}
