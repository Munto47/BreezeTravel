{
  "$defs": {
    "AuthorityPublicKey": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "ED25519",
          "default": "ED25519",
          "title": "Algorithm",
          "type": "string"
        },
        "authority_id": {
          "pattern": "^AUTH-[A-Z0-9-]{6,100}$",
          "title": "Authority Id",
          "type": "string"
        },
        "generated_by_task_id": {
          "maxLength": 160,
          "minLength": 8,
          "title": "Generated By Task Id",
          "type": "string"
        },
        "human_evidence": {
          "const": false,
          "default": false,
          "title": "Human Evidence",
          "type": "boolean"
        },
        "private_key_storage": {
          "const": "REPOSITORY_EXTERNAL",
          "default": "REPOSITORY_EXTERNAL",
          "title": "Private Key Storage",
          "type": "string"
        },
        "public_key_base64": {
          "maxLength": 60,
          "minLength": 40,
          "title": "Public Key Base64",
          "type": "string"
        },
        "public_key_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Public Key Sha256",
          "type": "string"
        },
        "role": {
          "enum": [
            "SEALED_CUSTODY",
            "AMAP_LIVE_EXPORTER",
            "QWEN_LIVE_EXPORTER",
            "AUTOMATED_PRODUCT_GATE",
            "LIVE_PROVIDER_GATE",
            "MULTI_AGENT_PANEL",
            "SEALED_AGENT_BLIND",
            "FINAL_GATE"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "authority_id",
        "public_key_base64",
        "public_key_sha256",
        "generated_by_task_id"
      ],
      "title": "AuthorityPublicKey",
      "type": "object"
    },
    "ProgramGoalAuthorityBinding": {
      "additionalProperties": false,
      "properties": {
        "automated_gate_contract_path": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Automated Gate Contract Path",
          "type": "string"
        },
        "automated_gate_contract_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Automated Gate Contract Sha256",
          "type": "string"
        },
        "goal_id": {
          "pattern": "^TC-VNEXT-G0[1-7]-[A-Z0-9-]+$",
          "title": "Goal Id",
          "type": "string"
        },
        "goal_sequence": {
          "maximum": 7,
          "minimum": 1,
          "title": "Goal Sequence",
          "type": "integer"
        },
        "initial_predecessor_completion_commit": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Initial Predecessor Completion Commit"
        },
        "predecessor_goal_id": {
          "pattern": "^TC-(?:BP-G00|VNEXT-G0[1-6])-[A-Z0-9-]+$",
          "title": "Predecessor Goal Id",
          "type": "string"
        }
      },
      "required": [
        "goal_sequence",
        "goal_id",
        "predecessor_goal_id",
        "automated_gate_contract_path",
        "automated_gate_contract_sha256"
      ],
      "title": "ProgramGoalAuthorityBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "authorities": {
      "items": {
        "$ref": "#/$defs/AuthorityPublicKey"
      },
      "maxItems": 20,
      "minItems": 8,
      "title": "Authorities",
      "type": "array"
    },
    "authority_activation_receipt_path": {
      "const": "backend/eval_data/agent_gate_v1/authority_activation_readiness.json",
      "default": "backend/eval_data/agent_gate_v1/authority_activation_readiness.json",
      "title": "Authority Activation Receipt Path",
      "type": "string"
    },
    "authority_generation": {
      "maximum": 7,
      "minimum": 1,
      "title": "Authority Generation",
      "type": "integer"
    },
    "authority_phase": {
      "enum": [
        "BOOTSTRAP",
        "ACTIVE"
      ],
      "title": "Authority Phase",
      "type": "string"
    },
    "bootstrap_core_paths": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Bootstrap Core Paths",
      "type": "array"
    },
    "candidate_freeze_ref_prefix": {
      "const": "refs/heads/codex/agent-gate-candidates/",
      "default": "refs/heads/codex/agent-gate-candidates/",
      "title": "Candidate Freeze Ref Prefix",
      "type": "string"
    },
    "canonical_candidate_ref": {
      "const": "refs/heads/codex/trip-check-product-reset",
      "default": "refs/heads/codex/trip-check-product-reset",
      "title": "Canonical Candidate Ref",
      "type": "string"
    },
    "canonical_origin_url": {
      "const": "https://github.com/Munto47/BreezeTravel.git",
      "default": "https://github.com/Munto47/BreezeTravel.git",
      "title": "Canonical Origin Url",
      "type": "string"
    },
    "component_verifier_paths": {
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "enum": [
          "AUTOMATED_PRODUCT_GATE",
          "LIVE_PROVIDER_GATE",
          "MULTI_AGENT_PANEL",
          "SEALED_AGENT_BLIND"
        ]
      },
      "title": "Component Verifier Paths",
      "type": "object"
    },
    "config_roots": {
      "items": {
        "type": "string"
      },
      "maxItems": 150,
      "minItems": 1,
      "title": "Config Roots",
      "type": "array"
    },
    "current_goal_binding_path": {
      "const": "docs/governance/current_goal_binding.json",
      "default": "docs/governance/current_goal_binding.json",
      "title": "Current Goal Binding Path",
      "type": "string"
    },
    "current_goal_document_path": {
      "const": "docs/governance/CURRENT_GOAL.md",
      "default": "docs/governance/CURRENT_GOAL.md",
      "title": "Current Goal Document Path",
      "type": "string"
    },
    "custody_registry_identity_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Custody Registry Identity Sha256",
      "type": "string"
    },
    "custody_registry_path_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Custody Registry Path Sha256",
      "type": "string"
    },
    "data_roots": {
      "items": {
        "type": "string"
      },
      "maxItems": 150,
      "minItems": 1,
      "title": "Data Roots",
      "type": "array"
    },
    "frozen_at": {
      "format": "date-time",
      "title": "Frozen At",
      "type": "string"
    },
    "goal_bindings": {
      "items": {
        "$ref": "#/$defs/ProgramGoalAuthorityBinding"
      },
      "maxItems": 7,
      "minItems": 7,
      "title": "Goal Bindings",
      "type": "array"
    },
    "human_evidence": {
      "const": false,
      "default": false,
      "title": "Human Evidence",
      "type": "boolean"
    },
    "immutable_protocol_paths": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Immutable Protocol Paths",
      "type": "array"
    },
    "legacy_baseline_commit": {
      "const": "7bdd1a6abd9c10c6076aca67f08de785027501a0",
      "default": "7bdd1a6abd9c10c6076aca67f08de785027501a0",
      "title": "Legacy Baseline Commit",
      "type": "string"
    },
    "live_exporter_paths": {
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "enum": [
          "SEALED_CUSTODY",
          "AMAP_LIVE_EXPORTER",
          "QWEN_LIVE_EXPORTER",
          "AUTOMATED_PRODUCT_GATE",
          "LIVE_PROVIDER_GATE",
          "MULTI_AGENT_PANEL",
          "SEALED_AGENT_BLIND",
          "FINAL_GATE"
        ]
      },
      "title": "Live Exporter Paths",
      "type": "object"
    },
    "policy_id": {
      "const": "TC-VNEXT-AGENT-GATE-V1",
      "default": "TC-VNEXT-AGENT-GATE-V1",
      "title": "Policy Id",
      "type": "string"
    },
    "process_isolation_only": {
      "const": true,
      "default": true,
      "title": "Process Isolation Only",
      "type": "boolean"
    },
    "program_core_paths": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Program Core Paths",
      "type": "array"
    },
    "program_id": {
      "const": "TC-VNEXT-2026",
      "default": "TC-VNEXT-2026",
      "title": "Program Id",
      "type": "string"
    },
    "schema_version": {
      "const": "agent-gate-authority-manifest-v1",
      "default": "agent-gate-authority-manifest-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_goal_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 7,
      "minItems": 7,
      "title": "Scope Goal Ids",
      "type": "array"
    },
    "status": {
      "const": "GOAL_SCOPED_IMMUTABLE_GENERATION",
      "default": "GOAL_SCOPED_IMMUTABLE_GENERATION",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "scope_goal_ids",
    "authority_generation",
    "authority_phase",
    "custody_registry_identity_sha256",
    "custody_registry_path_sha256",
    "config_roots",
    "data_roots",
    "program_core_paths",
    "immutable_protocol_paths",
    "bootstrap_core_paths",
    "goal_bindings",
    "component_verifier_paths",
    "live_exporter_paths",
    "authorities",
    "frozen_at"
  ],
  "title": "AgentGateAuthorityManifest",
  "type": "object"
}
