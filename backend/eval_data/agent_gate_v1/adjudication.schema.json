{
  "$defs": {
    "AdjudicatedFinding": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "pattern": "^AGF-[A-Z0-9-]{4,80}$",
          "title": "Finding Id",
          "type": "string"
        },
        "rationale": {
          "maxLength": 2000,
          "minLength": 12,
          "title": "Rationale",
          "type": "string"
        },
        "resolution": {
          "enum": [
            "ACCEPTED",
            "REJECTED",
            "DUPLICATE"
          ],
          "title": "Resolution",
          "type": "string"
        },
        "scope_disposition": {
          "enum": [
            "IN_CURRENT_GOAL",
            "DEFERRED_BY_PROGRAM",
            "NOT_APPLICABLE"
          ],
          "title": "Scope Disposition",
          "type": "string"
        },
        "severity": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source_review_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Review Sha256",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "source_review_sha256",
        "severity",
        "scope_disposition",
        "resolution",
        "rationale"
      ],
      "title": "AdjudicatedFinding",
      "type": "object"
    },
    "AgentTaskAttestation": {
      "additionalProperties": false,
      "properties": {
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "context_fork": {
          "const": "none",
          "default": "none",
          "title": "Context Fork",
          "type": "string"
        },
        "frozen_at": {
          "format": "date-time",
          "title": "Frozen At",
          "type": "string"
        },
        "human_evidence": {
          "const": false,
          "default": false,
          "title": "Human Evidence",
          "type": "boolean"
        },
        "input_bundle_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Bundle Sha256",
          "type": "string"
        },
        "isolated_context": {
          "const": true,
          "default": true,
          "title": "Isolated Context",
          "type": "boolean"
        },
        "model": {
          "const": "gpt-5.6-sol",
          "default": "gpt-5.6-sol",
          "title": "Model",
          "type": "string"
        },
        "output_schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Output Schema Sha256",
          "type": "string"
        },
        "prompt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Prompt Sha256",
          "type": "string"
        },
        "reasoning_effort": {
          "enum": [
            "xhigh",
            "ultra"
          ],
          "title": "Reasoning Effort",
          "type": "string"
        },
        "saw_prior_verdict": {
          "const": false,
          "default": false,
          "title": "Saw Prior Verdict",
          "type": "boolean"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "subject_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Subject Commit",
          "type": "string"
        },
        "subject_tree": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Subject Tree",
          "type": "string"
        },
        "task_id": {
          "maxLength": 160,
          "minLength": 8,
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "reasoning_effort",
        "prompt_sha256",
        "input_bundle_sha256",
        "output_schema_sha256",
        "subject_commit",
        "subject_tree",
        "started_at",
        "completed_at",
        "frozen_at"
      ],
      "title": "AgentTaskAttestation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "accepted_in_scope_p2_count": {
      "minimum": 0,
      "title": "Accepted In Scope P2 Count",
      "type": "integer"
    },
    "accepted_p0_count": {
      "minimum": 0,
      "title": "Accepted P0 Count",
      "type": "integer"
    },
    "accepted_p1_count": {
      "minimum": 0,
      "title": "Accepted P1 Count",
      "type": "integer"
    },
    "attestation": {
      "$ref": "#/$defs/AgentTaskAttestation"
    },
    "candidate_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Candidate Commit",
      "type": "string"
    },
    "candidate_config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Config Sha256",
      "type": "string"
    },
    "candidate_data_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Data Sha256",
      "type": "string"
    },
    "candidate_tree": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Candidate Tree",
      "type": "string"
    },
    "evidence_level": {
      "const": "MULTI_AGENT_SIMULATED_REVIEW",
      "default": "MULTI_AGENT_SIMULATED_REVIEW",
      "title": "Evidence Level",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/AdjudicatedFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "goal_id": {
      "pattern": "^TC-[A-Z0-9-]+$",
      "title": "Goal Id",
      "type": "string"
    },
    "required_scenario_union_complete": {
      "title": "Required Scenario Union Complete",
      "type": "boolean"
    },
    "schema_version": {
      "const": "agent-gate-adjudication-v1",
      "default": "agent-gate-adjudication-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_review_sha256": {
      "items": {
        "type": "string"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Source Review Sha256",
      "type": "array"
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "INCOMPLETE"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "required": [
    "goal_id",
    "candidate_commit",
    "candidate_tree",
    "candidate_config_sha256",
    "candidate_data_sha256",
    "source_review_sha256",
    "attestation",
    "findings",
    "accepted_p0_count",
    "accepted_p1_count",
    "accepted_in_scope_p2_count",
    "required_scenario_union_complete",
    "verdict"
  ],
  "title": "AgentGateAdjudicationReceipt",
  "type": "object"
}
