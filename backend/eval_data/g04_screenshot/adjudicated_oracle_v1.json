ld_id":"zhangjiajie.golden-whip-continue.33","field_type":"ACTIVITY_PLACE","must_confirm":false,"place_metric_eligibility":"NOT_APPLICABLE","reading_order_index":32,"region_xyxy":[923,163,970,177]},{"activity_role":"REFERENCE","expected_text":"金鞭溪","extraction":"CONTAINS_EXPECTED_TEXT","field_id":"zhangjiajie.golden-whip-route.34","field_type":"ACTIVITY_PLACE","must_confirm":false,"place_metric_eligibility":"NOT_APPLICABLE","reading_order_index":33,"region_xyxy":[610,188,657,203]},{"activity_role":null,"expected_text":"第一天","extraction":"CONTAINS_EXPECTED_TEXT","field_id":"zhangjiajie.day-one-afternoon.35","field_type":"DAY_MARKER","must_confirm":false,"place_metric_eligibility":"NOT_APPLICABLE","reading_order_index":34,"region_xyxy":[275,215,321,229]},{"activity_role":null,"expected_text":"下午四点多钟","extraction":"CONTAINS_EXPECTED_TEXT","field_id":"zhangjiajie.after-four-pm.36","field_type":"TIME_HINT","must_confirm":false,"place_metric_eligibility":"NOT_APPLICABLE","reading_order_index":35,"region_xyxy":[322,215,417,229]},{"activity_role":"PASS_THROUGH","expected_text":"砂刀沟","extraction":"CONTAINS_EXPECTED_TEXT","field_id":"zhangjiajie.shadaogou-junction.37","field_type":"ACTIVITY_PLACE","must_confirm":false,"place_metric_eligibility":"NOT_APPLICABLE","reading_order_index":36,"region_xyxy":[594,215,640,229]},{"activity_role":"OPTIONAL","expected_text":"袁家界","extraction":"CONTAINS_EXPECTED_TEXT","field_id":"zhangjiajie.yuanjiajie-road-option.38","field_type":"ACTIVITY_PLACE","must_confirm":false,"place_metric_eligibility":"NOT_APPLICABLE","reading_order_index":37,"region_xyxy":[787,215,833,229]},{"activity_role":null,"expected_text":"袁家界西面的公路边","extraction":"CONTAINS_EXPECTED_TEXT","field_id":"zhangjiajie.yuanjiajie-west-roadside.39","field_type":"AREA_ADDRESS","must_confirm":false,"place_metric_eligibility":"NOT_APPLICABLE","reading_order_index":38,"region_xyxy":[787,215,929,229]}],"forbidden_place_predictions":["张家界永定市区的中心汽车站","广场西侧（左面）的车站","上黄石寨","黄石寨地图","寨顶","黄石寨东面的山谷对面","下方山谷","北面远处","杨家界南\n缘","前山后山两条线","索道下站","鹞子\n寨","大氧吧广场附近有一些商亭","前者","后者","金鞭溪游览线4km多","水边","砂刀沟的岔口","袁家界西面的公路边","全程1小时以"],"paired_visible_text":"• 第一天，早上由张家界永定市区的中心汽车站乘车前往森林公园门票站。在旅游旺季，由于多数游客选择这个入口，一般早上八九点入口处\n就是人山人海了。买票进入，步行一段平路约6分钟，来到大氧吧广场，这里是许多旅行团和游客集中的地方，也是入园后的第一个风景\n点。这时可以选择往广场西侧（左面）的车站乘坐环保车约4分钟到黄石寨游览，也可以直接前往金鞭溪或鹞子寨。上黄石寨一般是坐索道\n（在下车的地方旁边坐，索道站可以拿黄石寨地图）到寨顶（寨顶较为平坦），七分钟后到达寨顶。寨顶的游览线路是环形的，出站向左向右\n皆可。绕整个寨顶一周大约100分钟，基本为平路，偶有起伏。黄石寨东面的山谷对面是袁家界，下方山谷是金鞭溪，北面远处是杨家界南\n缘。黄石寨游客不少，以六奇阁游客最多。若选择步行下山，有前山后山两条线，后山下山约1小时，到达索道下站；前山下山是多数人选择\n的线路，下山约需1小时，一路下台阶直达大氧吧广场。大氧吧广场附近有一些商亭卖东西，没有餐厅。之后便可以继续游览金鞭溪或鹞子\n寨。多数人选择前者，因为后者需要爬山，很远，而且较陡，适合登山爱好者。金鞭溪游览线4km多，全程很是惬意，旁边的溪水很清，可\n以到水边体验一下。走完一般是第一天下午四点多钟，走到后半途中有一个叫砂刀沟的岔口，一路上山可到袁家界西面的公路边，全程1小时以","source_file":"wikivoyage-zhangjiajie-oldid221547.jpg","source_sha256":"f23dba93b46e8fe9e576d2016cc3fb5f196ecf6dd946f1af69e2b7a862360d7b"},{"case_id":"licensed-qinling-oldid133737","fields":[{"activity_role":"PLANNED","expected_text":"都督门","extraction":"CONTAINS_EXPECTED_TEXT","field_id":"qinling.dudumen-summary.01","field_type":"ACTIVITY_PLACE","must_confirm":false,"place_metric_eligibility":"ELIGIBLE","reading_order_index":0,"region_xyxy":[50,7,96,21]},{"activity_role":"PLANNED","expected_text":"太白庙","extraction":"CONTAINS_EXPECTED_TEXT","field_id":"qinling.taibaimiao-summary.02","field_type":"ACTIVITY_PLACE","must_confirm":false,"place_metric_eligibility":"ELIGIBLE","reading_order_index":1,"region_xyxy":[102,7,148,21]},{"activity_role":"PLANNED","expected_text":"大坪","extraction":"CONTAINS_EXPECTED_TEXT","field_id":"qinling.daping-summary.03","field_type":"ACTIVITY_PLACE","must_confirm":false,"place_metric_eligibility":"ELIGIBLE","reading_order_index":2,"region_xyxy":[154,7,184,21]},{"activity_role":"PLANNED","expected_text":"灵官台","extraction":"CONTAINS_EXPECTED_TEXT","field_id":"qinling.lingguantai-summary.04","field_type":"ACTIVITY_PLACE","must_confirm":false,"place_metric_eligibility":"ELIGIBLE","reading_order_index":3,"region_xyxy":[189,7,235,21