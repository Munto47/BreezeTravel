{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://breezetravel.local/schemas/dual-entry-run-spec-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lane", "purpose", "sut", "dataset", "provider", "models", "comparison", "execution", "budget", "thresholds", "artifacts", "prohibitions"],
  "properties": {
    "schema_version": {"const": "dual-entry-run-spec-v1"},
    "lane": {"enum": ["pr_offline", "nightly_snapshot", "weekly_live", "release_blind", "human_calibration"]},
    "purpose": {"enum": ["contract", "development", "regression", "promotion", "human_calibration"]},
    "sut": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_sha", "dirty_diff_sha256", "runtime_config_sha256", "docker_image_digest", "base_url", "allow_direct_domain_calls", "allow_sql_seed"],
      "properties": {
        "commit_sha": {"type": "string"},
        "dirty_diff_sha256": {"type": "string"},
        "runtime_config_sha256": {"type": "string"},
        "docker_image_digest": {"type": "string"},
        "base_url": {"type": "string"},
        "allow_direct_domain_calls": {"type": "boolean"},
        "allow_sql_seed": {"type": "boolean"}
      }
    },
    "dataset": {
      "type": "object",
      "required": ["manifest", "manifest_sha256", "case_ids_sha256", "splits", "hash_policy", "label_access"],
      "properties": {
        "manifest": {"type": "string"},
        "manifest_sha256": {"type": "string"},
        "case_ids_sha256": {"type": "string"},
        "case_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
        "gate_case_seeds": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["case_ids", "required_min", "execution_status"],
            "properties": {
              "case_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
              "required_min": {"type": "integer", "minimum": 1},
              "execution_status": {"enum": ["SEED_ONLY_NOT_EXECUTED", "EXECUTED"]}
            }
          }
        },
        "graded_ranking_oracle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "label_authority", "path", "sha256", "source_snapshot_path", "source_snapshot_sha256", "identity_key", "scope"],
          "properties": {
            "schema_version": {"const": "frozen-suggestion-ranking-oracle-v1"},
            "label_authority": {"const": "AUTOMATED_DETERMINISTIC_PROXY_NOT_HUMAN"},
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "source_snapshot_path": {"type": "string", "minLength": 1},
            "source_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "identity_key": {"const": "canonical_place.place_id"},
            "scope": {"const": "development_only"}
          }
        },
        "splits": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["pilot", "dev", "regression", "frozen_blind", "temporal_canary", "human_calibration"]}},
        "hash_policy": {"const": "compute_and_freeze_before_run"},
        "label_access": {"enum": ["development_scorer", "isolated_scorer_only", "human_only"]}
      }
    },
    "provider": {
      "type": "object",
      "required": ["mode", "fixture_fallback_allowed", "receipts_required"],
      "properties": {
        "mode": {"enum": ["controlled_fixture", "frozen_snapshot", "live_provider", "human_only"]},
        "fixture_fallback_allowed": {"type": "boolean"},
        "receipts_required": {"type": "boolean"},
        "snapshot_id": {"type": ["string", "null"]},
        "snapshot_sha256": {"type": ["string", "null"]},
        "snapshot_path": {"type": ["string", "null"]},
        "import_snapshot_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "runtime_adapter_id", "required_fact_types", "status"],
          "properties": {
            "schema_version": {"const": "import-frozen-provider-contract-v1"},
            "runtime_adapter_id": {"const": "import-frozen-entity-route-weather-v1"},
            "required_fact_types": {
              "type": "array",
              "prefixItems": [
                {"const": "ENTITY_RESOLUTION"},
                {"const": "ROUTE_TIME"},
                {"const": "WEATHER"}
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            },
            "status": {"enum": ["BLOCKED_MISSING_ARTIFACT", "READY"]}
          }
        }
      }
    },
    "models": {"type": "object"},
    "comparison": {"type": "object", "required": ["baseline_run_id", "threshold_set_version", "paired_only", "confidence", "noninferiority_margin"]},
    "execution": {"type": "object", "required": ["resume_at_case_boundary", "normalize_volatile_fields", "cache_namespace_sha256", "retry_policy_version"]},
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend_yjs_restart"],
      "properties": {
        "backend_yjs_restart": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "command_id", "opt_in_env", "claim_scope", "matrix_version", "required_case_count", "case_ids", "evidence_path", "direct_domain_calls", "sql_seed_operations"],
          "properties": {
            "required": {"type": "boolean"},
            "command_id": {"type": "string", "minLength": 1},
            "opt_in_env": {"const": "BREEZE_EVAL_ALLOW_SERVICE_RESTART"},
            "claim_scope": {"const": "local_fixture_public_http_yjs_browser"},
            "matrix_version": {"const": "g5-backend-yjs-restart-v1"},
            "required_case_count": {"const": 9},
            "case_ids": {"type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true, "items": {"type": "string", "pattern": "^g5\\.(bj|sh|hz)\\.restart\\."}},
            "evidence_path": {"const": "backend/evidence/full_stack/dual_user_backend_yjs_restart_2026-08-20.json"},
            "direct_domain_calls": {"const": 0},
            "sql_seed_operations": {"const": 0}
          }
        }
      }
    },
    "budget": {"type": "object", "required": ["paid_api_allowed", "max_total_cost_cny", "max_concurrency", "max_case_seconds"]},
    "thresholds": {"type": "object", "minProperties": 1},
    "artifacts": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string"}},
    "prohibitions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
  }
}
