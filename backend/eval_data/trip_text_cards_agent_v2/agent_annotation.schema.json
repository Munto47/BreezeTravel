{
  "$defs": {
    "AgentAnnotationAttestation": {
      "additionalProperties": false,
      "properties": {
        "candidate_output_visibility": {
          "const": "NONE",
          "default": "NONE",
          "title": "Candidate Output Visibility",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "context_fork": {
          "const": "none",
          "default": "none",
          "title": "Context Fork",
          "type": "string"
        },
        "frozen_at": {
          "format": "date-time",
          "title": "Frozen At",
          "type": "string"
        },
        "human_evidence": {
          "const": false,
          "default": false,
          "title": "Human Evidence",
          "type": "boolean"
        },
        "input_bundle_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Bundle Sha256",
          "type": "string"
        },
        "isolated_context": {
          "const": true,
          "default": true,
          "title": "Isolated Context",
          "type": "boolean"
        },
        "model": {
          "const": "gpt-5.6-sol",
          "default": "gpt-5.6-sol",
          "title": "Model",
          "type": "string"
        },
        "output_schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Output Schema Sha256",
          "type": "string"
        },
        "peer_output_visibility": {
          "const": "NONE",
          "default": "NONE",
          "title": "Peer Output Visibility",
          "type": "string"
        },
        "prompt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Prompt Sha256",
          "type": "string"
        },
        "provider_receipts_used": {
          "const": true,
          "default": true,
          "title": "Provider Receipts Used",
          "type": "boolean"
        },
        "raw_output_storage": {
          "const": "REPOSITORY_EXTERNAL",
          "default": "REPOSITORY_EXTERNAL",
          "title": "Raw Output Storage",
          "type": "string"
        },
        "reasoning_effort": {
          "const": "xhigh",
          "default": "xhigh",
          "title": "Reasoning Effort",
          "type": "string"
        },
        "saw_candidate_predictions_before_submission": {
          "const": false,
          "default": false,
          "title": "Saw Candidate Predictions Before Submission",
          "type": "boolean"
        },
        "saw_peer_output_before_submission": {
          "const": false,
          "default": false,
          "title": "Saw Peer Output Before Submission",
          "type": "boolean"
        },
        "saw_prior_verdict": {
          "const": false,
          "default": false,
          "title": "Saw Prior Verdict",
          "type": "boolean"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "subject_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Subject Commit",
          "type": "string"
        },
        "subject_tree": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Subject Tree",
          "type": "string"
        },
        "task_id": {
          "maxLength": 160,
          "minLength": 8,
          "title": "Task Id",
          "type": "string"
        },
        "task_role": {
          "enum": [
            "ANNOTATOR_A",
            "ANNOTATOR_B"
          ],
          "title": "Task Role",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "prompt_sha256",
        "input_bundle_sha256",
        "output_schema_sha256",
        "subject_commit",
        "subject_tree",
        "started_at",
        "completed_at",
        "frozen_at",
        "task_role"
      ],
      "title": "AgentAnnotationAttestation",
      "type": "object"
    },
    "AgentCanonicalPlaceLabel": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "const": "PROVIDER_BOUND_AGENT_REFERENCE",
          "default": "PROVIDER_BOUND_AGENT_REFERENCE",
          "title": "Authority",
          "type": "string"
        },
        "category": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "city": {
          "maxLength": 80,
          "minLength": 1,
          "title": "City",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "place_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Place Id",
          "type": "string"
        },
        "provider_receipt": {
          "$ref": "#/$defs/ProviderReceiptRef"
        }
      },
      "required": [
        "place_id",
        "name",
        "city",
        "category",
        "provider_receipt"
      ],
      "title": "AgentCanonicalPlaceLabel",
      "type": "object"
    },
    "AgentCaseAnnotation": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^G01-TC-\\d{3}$",
          "title": "Case Id",
          "type": "string"
        },
        "destination_basis": {
          "enum": [
            "EXPLICIT",
            "SOFT_ASSUMPTION"
          ],
          "title": "Destination Basis",
          "type": "string"
        },
        "destination_evidence_raw_text": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Destination Evidence Raw Text"
        },
        "destination_evidence_span_end": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Destination Evidence Span End"
        },
        "destination_evidence_span_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Destination Evidence Span Start"
        },
        "destination_name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Destination Name",
          "type": "string"
        },
        "mentions": {
          "items": {
            "$ref": "#/$defs/AgentMentionAnnotation"
          },
          "minItems": 1,
          "title": "Mentions",
          "type": "array"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "source_sha256",
        "destination_name",
        "destination_basis",
        "mentions"
      ],
      "title": "AgentCaseAnnotation",
      "type": "object"
    },
    "AgentMentionAnnotation": {
      "additionalProperties": false,
      "properties": {
        "atomic_place_name": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Atomic Place Name"
        },
        "canonical_place": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentCanonicalPlaceLabel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "day_index": {
          "anyOf": [
            {
              "maximum": 14,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Day Index"
        },
        "executable_place": {
          "title": "Executable Place",
          "type": "boolean"
        },
        "mention_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Mention Id",
          "type": "string"
        },
        "place_boundary_basis": {
          "enum": [
            "PROVIDER_ACCEPTED_EXACT",
            "SOURCE_VERBATIM_ATOMIC",
            "NONE"
          ],
          "title": "Place Boundary Basis",
          "type": "string"
        },
        "place_boundary_status": {
          "enum": [
            "VERIFIED_ATOMIC",
            "UNCERTAIN",
            "NONE"
          ],
          "title": "Place Boundary Status",
          "type": "string"
        },
        "provider_resolution_receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderReceiptRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "raw_text": {
          "minLength": 1,
          "title": "Raw Text",
          "type": "string"
        },
        "role": {
          "enum": [
            "PLANNED",
            "OPTIONAL",
            "REFERENCE",
            "EXCLUDED",
            "PASS_THROUGH"
          ],
          "title": "Role",
          "type": "string"
        },
        "semantic_kind": {
          "enum": [
            "PLACE",
            "URL",
            "DESCRIPTION",
            "RESERVATION",
            "OTHER"
          ],
          "title": "Semantic Kind",
          "type": "string"
        },
        "span_end": {
          "exclusiveMinimum": 0,
          "title": "Span End",
          "type": "integer"
        },
        "span_start": {
          "minimum": 0,
          "title": "Span Start",
          "type": "integer"
        }
      },
      "required": [
        "mention_id",
        "span_start",
        "span_end",
        "raw_text",
        "semantic_kind",
        "role",
        "place_boundary_status",
        "place_boundary_basis",
        "executable_place"
      ],
      "title": "AgentMentionAnnotation",
      "type": "object"
    },
    "ProviderReceiptRef": {
      "additionalProperties": false,
      "properties": {
        "accepted_source_name": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accepted Source Name"
        },
        "authorization_basis": {
          "const": "OWNER_ATTESTED_EXISTING_AUTHORIZATION",
          "default": "OWNER_ATTESTED_EXISTING_AUTHORIZATION",
          "title": "Authorization Basis",
          "type": "string"
        },
        "execution_mode": {
          "enum": [
            "LIVE",
            "CONTROLLED_FIXTURE"
          ],
          "title": "Execution Mode",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "provider": {
          "const": "AMAP",
          "default": "AMAP",
          "title": "Provider",
          "type": "string"
        },
        "provider_binding_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Provider Binding Sha256",
          "type": "string"
        },
        "queried_city": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Queried City",
          "type": "string"
        },
        "queried_source_name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Queried Source Name",
          "type": "string"
        },
        "raw_response_in_git": {
          "const": false,
          "default": false,
          "title": "Raw Response In Git",
          "type": "boolean"
        },
        "receipt_id": {
          "maxLength": 160,
          "minLength": 8,
          "title": "Receipt Id",
          "type": "string"
        },
        "receipt_ref": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Receipt Ref",
          "type": "string"
        },
        "request_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "resolution_status": {
          "enum": [
            "MATCHED",
            "UNRESOLVED",
            "AMBIGUOUS"
          ],
          "title": "Resolution Status",
          "type": "string"
        },
        "response_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Response Sha256",
          "type": "string"
        },
        "retention": {
          "const": "REDACTED_MINIMAL",
          "default": "REDACTED_MINIMAL",
          "title": "Retention",
          "type": "string"
        },
        "runtime_effect_id": {
          "maxLength": 160,
          "minLength": 8,
          "title": "Runtime Effect Id",
          "type": "string"
        },
        "runtime_effect_receipt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Runtime Effect Receipt Sha256",
          "type": "string"
        }
      },
      "required": [
        "receipt_id",
        "execution_mode",
        "provider_binding_sha256",
        "receipt_ref",
        "runtime_effect_id",
        "runtime_effect_receipt_sha256",
        "request_sha256",
        "response_sha256",
        "observed_at",
        "resolution_status",
        "queried_source_name",
        "queried_city"
      ],
      "title": "ProviderReceiptRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assignment_id": {
      "maxLength": 120,
      "minLength": 8,
      "title": "Assignment Id",
      "type": "string"
    },
    "attestation": {
      "$ref": "#/$defs/AgentAnnotationAttestation"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/AgentCaseAnnotation"
      },
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    },
    "dataset_version": {
      "const": "g01-text-card-dataset-v1",
      "default": "g01-text-card-dataset-v1",
      "title": "Dataset Version",
      "type": "string"
    },
    "goal_id": {
      "const": "TC-VNEXT-G01-TEXT-CARDS",
      "default": "TC-VNEXT-G01-TEXT-CARDS",
      "title": "Goal Id",
      "type": "string"
    },
    "schema_version": {
      "const": "g01-text-card-agent-annotation-bundle-v2",
      "default": "g01-text-card-agent-annotation-bundle-v2",
      "title": "Schema Version",
      "type": "string"
    },
    "split": {
      "enum": [
        "dev",
        "validation"
      ],
      "title": "Split",
      "type": "string"
    }
  },
  "required": [
    "assignment_id",
    "split",
    "attestation",
    "cases"
  ],
  "title": "AgentAnnotationBundle",
  "type": "object"
}
