{
  "$defs": {
    "DetachedAuthoritySignature": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "ED25519",
          "default": "ED25519",
          "title": "Algorithm",
          "type": "string"
        },
        "authority_id": {
          "pattern": "^AUTH-[A-Z0-9-]{6,100}$",
          "title": "Authority Id",
          "type": "string"
        },
        "authority_role": {
          "enum": [
            "SEALED_CUSTODY",
            "AMAP_LIVE_EXPORTER",
            "QWEN_LIVE_EXPORTER",
            "AUTOMATED_PRODUCT_GATE",
            "LIVE_PROVIDER_GATE",
            "MULTI_AGENT_PANEL",
            "SEALED_AGENT_BLIND",
            "FINAL_GATE"
          ],
          "title": "Authority Role",
          "type": "string"
        },
        "signature_base64": {
          "maxLength": 100,
          "minLength": 80,
          "title": "Signature Base64",
          "type": "string"
        },
        "signed_payload_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Signed Payload Sha256",
          "type": "string"
        }
      },
      "required": [
        "authority_role",
        "authority_id",
        "signed_payload_sha256",
        "signature_base64"
      ],
      "title": "DetachedAuthoritySignature",
      "type": "object"
    },
    "ProviderHttpExchangeReceipt": {
      "additionalProperties": false,
      "properties": {
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "effect_id": {
          "maxLength": 160,
          "minLength": 8,
          "title": "Effect Id",
          "type": "string"
        },
        "http_status": {
          "maximum": 299,
          "minimum": 200,
          "title": "Http Status",
          "type": "integer"
        },
        "provider_request_id_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Request Id Sha256"
        },
        "provider_status": {
          "const": "SUCCESS",
          "default": "SUCCESS",
          "title": "Provider Status",
          "type": "string"
        },
        "raw_response_retained": {
          "const": false,
          "default": false,
          "title": "Raw Response Retained",
          "type": "boolean"
        },
        "request_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "response_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Response Sha256",
          "type": "string"
        }
      },
      "required": [
        "effect_id",
        "request_sha256",
        "response_sha256",
        "http_status",
        "completed_at"
      ],
      "title": "ProviderHttpExchangeReceipt",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "authority_policy_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Authority Policy Sha256"
    },
    "authority_signature": {
      "anyOf": [
        {
          "$ref": "#/$defs/DetachedAuthoritySignature"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "candidate_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Candidate Commit",
      "type": "string"
    },
    "candidate_tree": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Candidate Tree",
      "type": "string"
    },
    "captured_at": {
      "format": "date-time",
      "title": "Captured At",
      "type": "string"
    },
    "exchanges": {
      "items": {
        "$ref": "#/$defs/ProviderHttpExchangeReceipt"
      },
      "minItems": 1,
      "title": "Exchanges",
      "type": "array"
    },
    "execution_mode": {
      "enum": [
        "LIVE",
        "CONTROLLED_FIXTURE"
      ],
      "title": "Execution Mode",
      "type": "string"
    },
    "goal_id": {
      "const": "TC-VNEXT-G01-TEXT-CARDS",
      "default": "TC-VNEXT-G01-TEXT-CARDS",
      "title": "Goal Id",
      "type": "string"
    },
    "provider_binding_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Provider Binding Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "g01-amap-http-receipt-bundle-v2",
      "default": "g01-amap-http-receipt-bundle-v2",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "candidate_commit",
    "candidate_tree",
    "provider_binding_sha256",
    "execution_mode",
    "captured_at",
    "exchanges"
  ],
  "title": "ProviderHttpReceiptBundle",
  "type": "object"
}
