{
  "schema_version": "dual-entry-run-spec-v1",
  "lane": "nightly_snapshot",
  "purpose": "development",
  "sut": {
    "commit_sha": "RESOLVE_AT_RUN_START",
    "dirty_diff_sha256": "RESOLVE_AT_RUN_START",
    "runtime_config_sha256": "RESOLVE_AT_RUN_START",
    "docker_image_digest": "RESOLVE_AT_RUN_START",
    "base_url": "http://127.0.0.1:8000",
    "allow_direct_domain_calls": false,
    "allow_sql_seed": false
  },
  "dataset": {
    "manifest": "backend/eval_data/dual_entry_v1/manifest.json",
    "manifest_sha256": "RESOLVE_AT_RUN_START",
    "case_ids_sha256": "RESOLVE_AT_RUN_START",
    "case_ids": [
      "dev.bj.import.time-route-conflict",
      "dev.bj.import.opening-reservation",
      "dev.bj.import.elderly-pacing",
      "dev.bj.import.partial-provider-failure",
      "dev.sh.import.arrival-return-boundary",
      "dev.sh.import.child-meal-rest",
      "dev.sh.import.accessibility-unknown",
      "dev.sh.import.repair-locked",
      "dev.hz.import.cross-zone-pingpong",
      "dev.hz.import.rain-outdoor",
      "dev.hz.import.food-allergy",
      "dev.hz.import.conflicting-hours",
      "reg.sh.import.no-sql-fact-continuity"
    ],
    "splits": ["dev", "regression"],
    "hash_policy": "compute_and_freeze_before_run",
    "label_access": "development_scorer"
  },
  "provider": {
    "mode": "frozen_snapshot",
    "fixture_fallback_allowed": false,
    "receipts_required": true,
    "snapshot_id": "REQUIRED_AT_RUN_START",
    "snapshot_sha256": "REQUIRED_AT_RUN_START",
    "snapshot_path": "REQUIRED_AT_RUN_START",
    "import_snapshot_contract": {
      "schema_version": "import-frozen-provider-contract-v1",
      "runtime_adapter_id": "import-frozen-entity-route-weather-v1",
      "required_fact_types": ["ENTITY_RESOLUTION", "ROUTE_TIME", "WEATHER"],
      "status": "BLOCKED_MISSING_ARTIFACT"
    }
  },
  "models": {
    "generator": {"enabled": false, "model": "disabled", "prompt_sha256": "disabled"},
    "parser_fallback": {"enabled": false, "model": "disabled", "prompt_sha256": "disabled"},
    "correction": {"enabled": false, "model": "disabled", "prompt_sha256": "disabled"},
    "judge": {"enabled": false, "model": "disabled", "prompt_sha256": "disabled", "rubric_version": "semantic-rubric-v1"}
  },
  "comparison": {
    "baseline_run_id": "REQUIRED_AT_RUN_START",
    "threshold_set_version": "import-nightly-frozen-entity-route-weather-v1",
    "paired_only": true,
    "confidence": 0.95,
    "noninferiority_margin": 0.02
  },
  "execution": {
    "resume_at_case_boundary": true,
    "normalize_volatile_fields": true,
    "cache_namespace_sha256": "RESOLVE_AT_RUN_START",
    "retry_policy_version": "snapshot-no-fallback-v1",
    "claim_scope": "g2_import_frozen_snapshot_only_after_artifact_binding"
  },
  "budget": {"paid_api_allowed": false, "max_total_cost_cny": 0, "max_concurrency": 1, "max_case_seconds": 60},
  "thresholds": {
    "http_import_cases_min": 30,
    "parse_f1": 0.95,
    "entity_precision": 0.98,
    "entity_recall": 0.98,
    "blocker_high_precision": 0.90,
    "blocker_high_recall": 0.85,
    "repair_postcheck": 1.0,
    "provider_receipt_contract_rate": 1.0,
    "offered_receipt_case_rate": 1.0,
    "materialized_receipt_eligible_case_rate": 1.0,
    "wrong_city_rejected_receipt_rate": 1.0,
    "unknown_to_satisfied": 0
  },
  "artifacts": [
    "run_spec.json",
    "product_outputs.jsonl",
    "provider_receipts.jsonl",
    "http_transactions.jsonl",
    "deterministic_scores.json",
    "bad_cases.jsonl",
    "cost.json",
    "gate.json"
  ],
  "prohibitions": [
    "paid_api_call",
    "sql_seed",
    "direct_domain_call",
    "blind_label_access",
    "fixture_fallback",
    "fixture_marked_frozen",
    "unknown_promoted"
  ]
}
