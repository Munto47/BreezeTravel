{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trip-check-p5-blind-review-receipt-v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_status", "candidate_subject_commit", "bundle_byte_sha256", "bundle_canonical_sha256", "labels_canonical_sha256", "oracle_derivation_sha256", "dataset_binding", "checks", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "trip-check-p5-blind-review-receipt-v2"},
    "review_status": {"const": "PASS"},
    "candidate_subject_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "bundle_byte_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bundle_canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "labels_canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "oracle_derivation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dataset_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_count", "case_ids_sha256", "inputs_file_sha256", "inputs_content_sha256", "materializations_file_sha256", "materializations_content_sha256", "schema_contract_sha256", "run_spec_template_sha256", "rubric_sha256", "variant_ids_sha256"],
      "properties": {
        "case_count": {"const": 90},
        "case_ids_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "inputs_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "inputs_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "materializations_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "materializations_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "run_spec_template_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "rubric_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "variant_ids_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_count", "case_set_exact", "binding_recomputed", "oracle_exact", "privacy_findings_count", "candidate_output_dependency_count", "network_api_calls", "unknown_preserved_count", "candidate_set_mode_counts", "concurrency_case_count"],
      "properties": {
        "case_count": {"const": 90},
        "case_set_exact": {"const": true},
        "binding_recomputed": {"const": true},
        "oracle_exact": {"const": true},
        "privacy_findings_count": {"const": 0},
        "candidate_output_dependency_count": {"const": 0},
        "network_api_calls": {"const": 0},
        "unknown_preserved_count": {"const": 18},
        "concurrency_case_count": {"const": 20},
        "candidate_set_mode_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["VALID", "EMPTY", "MISSING_RECEIPT", "NOT_APPLICABLE"],
          "properties": {"VALID": {"const": 10}, "EMPTY": {"const": 10}, "MISSING_RECEIPT": {"const": 10}, "NOT_APPLICABLE": {"const": 60}}
        }
      }
    }
  }
}
