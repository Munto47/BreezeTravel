{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trip-check-p5-blind-oracle-correction-receipt-v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "candidate_subject_commit",
    "source_bundle_sha256",
    "source_labels_canonical_sha256",
    "corrected_bundle_byte_sha256",
    "corrected_bundle_canonical_sha256",
    "corrected_labels_canonical_sha256",
    "dataset_binding",
    "correction_scope",
    "changed_label_count",
    "changed_field",
    "non_target_oracle_diff_count",
    "blind_payload_changed",
    "policy_mapping_sha256",
    "correction_tool_sha256",
    "network_api_calls",
    "blind_detail_emitted",
    "human_evidence",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "trip-check-p5-blind-oracle-correction-receipt-v5"},
    "status": {"const": "PASS"},
    "candidate_subject_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_labels_canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "corrected_bundle_byte_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "corrected_bundle_canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "corrected_labels_canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dataset_binding": {"$ref": "#/$defs/dataset_binding"},
    "correction_scope": {"const": "specific_place_allowed_payload_policy_only"},
    "changed_label_count": {"const": 60},
    "changed_field": {"const": "oracle.candidate_receipt_expectation.specific_place_allowed"},
    "non_target_oracle_diff_count": {"const": 0},
    "blind_payload_changed": {"const": false},
    "policy_mapping_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "correction_tool_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "network_api_calls": {"const": 0},
    "blind_detail_emitted": {"const": false},
    "human_evidence": {"const": false},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "dataset_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_count", "case_ids_sha256", "inputs_file_sha256", "inputs_content_sha256", "materializations_file_sha256", "materializations_content_sha256", "schema_contract_sha256", "run_spec_template_sha256", "rubric_sha256", "variant_ids_sha256"],
      "properties": {
        "case_count": {"const": 90},
        "case_ids_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "inputs_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "inputs_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "materializations_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "materializations_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "run_spec_template_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "rubric_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "variant_ids_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
