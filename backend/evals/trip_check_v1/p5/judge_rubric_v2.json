{
  "dimensions": {
    "actionability": {
      "description": "The response gives a concrete next action without inventing a verified fact.",
      "maximum": 4,
      "minimum": 0
    },
    "clarity": {
      "description": "The response explains the issue and consequence in plain language.",
      "maximum": 4,
      "minimum": 0
    },
    "evidence_boundary_expression": {
      "description": "The response separates verified evidence, uncertainty, and unavailable facts.",
      "maximum": 4,
      "minimum": 0
    }
  },
  "fact_authority": "DETERMINISTIC_ORACLE_ONLY",
  "human_calibration_performed": false,
  "human_evidence": false,
  "input_policy": {
    "anonymous_variant": true,
    "blind_label_present": false,
    "deterministic_oracle_present": false,
    "evidence_summary_only": true
  },
  "judge_class": "automated_proxy_judge",
  "judge_may_decide": [
    "clarity",
    "actionability",
    "evidence_boundary_expression"
  ],
  "judge_must_not_decide": [
    "place_or_city_correctness",
    "route_or_weather_fact",
    "finding_presence_or_severity",
    "unknown_preservation",
    "candidate_receipt_validity",
    "repair_postcheck_safety"
  ],
  "schema_version": "trip-check-p5-judge-rubric-v2"
}
