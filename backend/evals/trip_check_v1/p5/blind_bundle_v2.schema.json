{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trip-check-p5-blind-label-bundle-v2",
  "type": "object",
  "required": ["schema_version", "evidence_class", "human_evidence", "dataset_binding", "labels"],
  "properties": {
    "schema_version": {"const": "trip-check-p5-blind-label-bundle-v2"},
    "evidence_class": {"const": "controlled_blind_oracle"},
    "human_evidence": {"const": false},
    "dataset_binding": {"type": "object", "additionalProperties": false, "required": ["case_count", "case_ids_sha256", "inputs_file_sha256", "inputs_content_sha256", "materializations_file_sha256", "materializations_content_sha256", "run_spec_template_sha256", "rubric_sha256", "variant_ids_sha256"], "properties": {"case_count": {"const": 90}, "case_ids_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "inputs_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "inputs_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "materializations_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "materializations_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "run_spec_template_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "rubric_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "variant_ids_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "labels": {"type": "array", "minItems": 90, "maxItems": 90, "items": {"type": "object", "additionalProperties": false, "required": ["schema_version", "case_id", "oracle"], "properties": {"schema_version": {"const": "trip-check-p5-blind-label-v2"}, "case_id": {"type": "string"}, "oracle": {"type": "object"}}}}
  },
  "additionalProperties": false
}
