{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trip-check-p5-judge-bundle-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "round_index", "evidence_class", "human_evidence", "run_binding", "rubric", "items"],
  "properties": {
    "schema_version": {"const": "trip-check-p5-judge-bundle-v2"},
    "round_index": {"type": "integer", "minimum": 1, "maximum": 3},
    "evidence_class": {"const": "automated_proxy_judge_input"},
    "human_evidence": {"const": false},
    "run_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_commit", "run_group_manifest_hash", "terminal_outputs_file_sha256", "terminal_outputs_content_sha256", "variant_output_sha256", "rubric_sha256", "mapping_commitment"],
      "properties": {
        "subject_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "run_group_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "terminal_outputs_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "terminal_outputs_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "variant_output_sha256": {"type": "object"},
        "rubric_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "mapping_commitment": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "rubric": {"type": "object"},
    "items": {"type": "array", "minItems": 270, "maxItems": 270}
  }
}
