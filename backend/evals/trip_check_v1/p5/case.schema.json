{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trip-check-p5-eval-case-v1",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "split",
    "city",
    "trip_days",
    "group_size",
    "input_kind",
    "difficulty",
    "coverage_tags",
    "product_input",
    "runner_control",
    "lineage",
    "source_ref",
    "normalized_input_sha256",
    "provenance",
    "case_hash"
  ],
  "properties": {
    "schema_version": {"const": "trip-check-p5-eval-case-v1"},
    "case_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["pilot", "dev", "regression", "frozen_blind"]},
    "city": {"enum": ["北京", "上海", "杭州"]},
    "trip_days": {"type": "integer", "minimum": 2, "maximum": 5},
    "group_size": {"type": "integer", "minimum": 2, "maximum": 5},
    "input_kind": {"enum": ["TEXT", "SYNTHETIC_SCREENSHOT"]},
    "difficulty": {"enum": ["CLEAN", "MEDIUM", "HARD"]},
    "coverage_tags": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "product_input": {"type": "object"},
    "runner_control": {"type": "object"},
    "lineage": {"type": "object"},
    "source_ref": {"type": "object"},
    "normalized_input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "oracle": {"type": "object"},
    "oracle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provenance": {"type": "object"},
    "case_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
