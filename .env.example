# =============================================================
# AI 智能旅行协同规划系统 — 后端环境变量模板
# cp .env.example .env  然后填写真实值
# =============================================================

# ===== 主 LLM：DeepSeek API =====
# deepseek-chat   : 通用对话（Router / Synthesizer / HyDE）
# deepseek-reasoner: 深度推理 R1 模型（复杂规划任务）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_API_URL=https://api.deepseek.com/v1

# ===== 备用 LLM：OpenAI 兼容接口 =====
# 未配置 DEEPSEEK_API_KEY 时自动回退到此接口
# 支持 OpenAI 官方 / SiliconFlow / 其他兼容服务
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_API_URL=https://api.openai.com/v1

# ===== Embedding API =====
# 留空则自动复用 OPENAI_API_KEY / OPENAI_API_URL
# EMBEDDING_API_KEY=
# EMBEDDING_API_URL=
# EMBEDDING_MODEL=text-embedding-3-small

# ===== Advanced RAG 配置 =====
# HYDE_ENABLED=true           # HyDE 查询扩展（默认开启）
# RERANKER_ENABLED=true       # Cross-Encoder 重排序（需 FlagEmbedding）
# RERANKER_DEVICE=cpu         # "cpu"（默认）| "cuda"（有 GPU 时改为 cuda 加速）

# ===== 高德地图（两个 Key 类型不同，不可互换）=====

# 后端 REST API Key — 高德控制台新建"Web服务"类型
AMAP_API_KEY=your-amap-rest-api-key

# true=使用本地 Mock 数据（默认，保护 API 配额）; false=真实调用高德 API
AMAP_MOCK=true

# 受控本地 Docker 文本导入使用 local_fixture + AMAP_MOCK=true；候选会明确
# 标为 fixture，不能当作实时 Provider 或发布证据。真实本地验证使用 local_real。
RUNTIME_PROFILE=local_fixture

# ===== SuggestionSet Provider 模式 =====
# 默认 auto 沿用 AMAP_MOCK/DEMO_MODE 选择 live 或 fixture。
# 本地可复现的真实 Provider 快照评测必须同时显式配置以下五项；
# 模式为 live/fixture/auto 时不允许保留任何 snapshot 字段。
# SUGGESTION_PROVIDER_MODE=frozen_snapshot
# SUGGESTION_SNAPSHOT_PATH=backend/evidence/real_provider_local_authorized/suggestion_snapshot_2026-08-21.json
# SUGGESTION_SNAPSHOT_SHA256=9e93086e4c764ac7c5aa628d6e857a7b03f3a8939a9971a7631e27607a792c04
# SUGGESTION_SNAPSHOT_ID=d64231204b8319cb488754afc331800dd0c51e41b2a2f3ba15194c3c2f2bc5bd
# SUGGESTION_SNAPSHOT_REPLAY_AT=2026-08-21T04:11:29.399183Z

# P8 临行复检默认只重放不可变快照，不消耗 Provider 配额。仅在
# AMAP_MOCK=false、DEMO_MODE=false、真实 AMAP_API_KEY 和 local_real/public
# runtime_profile 都满足时，设为 true 才会逐地点请求实时 POI 事实。
# 即使为 true，失败仍会写入降级证据；它不等于真人验收或公网发布开关。
PRE_TRIP_LIVE_PROVIDER_RECHECK_ENABLED=false

# ===== 和风天气 =====
# 推荐使用 JWT 认证（无 Host 白名单限制，服务端调用安全）
# 步骤：控制台 → 项目管理 → 添加凭据 → 选择 JSON Web Token → 上传公钥
QWEATHER_API_HOST=xxxxxxxx.re.qweatherapi.com  # 控制台「项目管理」→ API Host 字段
QWEATHER_AUTH_TYPE=jwt                  # "jwt"（推荐）或 "apikey"

# 微信小程序登录（缺失时 /api/auth/wechat/login fail closed）
WECHAT_MINIPROGRAM_APP_ID=
WECHAT_MINIPROGRAM_APP_SECRET=
WECHAT_IDENTITY_HASH_KEY=

# JWT 模式必填（凭据 ID 和项目 ID 在控制台-项目管理中查看）
QWEATHER_PRIVATE_KEY=your-ed25519-private-key-base64  # PKCS8 私钥 base64 正文（不含 PEM 头尾）
QWEATHER_KEY_ID=your-credential-id                    # 控制台凭据 ID（kid）
QWEATHER_PROJECT_ID=your-project-id                   # 控制台项目 ID（sub）

# API KEY 模式（降级备用，需控制台设置 Host 为无限制）
# QWEATHER_API_KEY=your-qweather-api-key
# QWEATHER_AUTH_TYPE=apikey

# ===== 数据库（docker-compose 启动时会自动覆盖此值）=====
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/travel_agent
REDIS_URL=redis://localhost:6379

# ===== 阿里云短信服务（手机验证码登录）=====
# 控制台：https://dysms.console.aliyun.com
# 未填写时自动进入 Mock 模式（验证码打印到服务端日志，可直接测试）
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SMS_SIGN_NAME=BreezeTravel
ALIBABA_CLOUD_SMS_TEMPLATE_CODE=SMS_xxxxxxx

# ===== JWT 鉴权密钥 =====
# 生产环境请设置为足够随机的长字符串（openssl rand -hex 32）
JWT_SECRET_KEY=change-me-in-production-please

# ===== LangSmith 可观测性（Sprint 5 新增，可选）=====
# 配置后所有 Agent 调用链路自动上报到 LangSmith 控制台
# 注册：https://smith.langchain.com/
# LANGSMITH_API_KEY=lsv2_pt_your-key-here
# LANGSMITH_PROJECT=BreezeTravel

# ===== Demo 模式 =====
# true=跳过所有 LLM 调用，返回预置数据（无需任何 API Key 即可完整体验）
DEMO_MODE=false

# ===== Public demo guard =====
# 公网演示开启后，后端使用 Redis 共享滑动窗口；生产仍建议叠加 WAF/网关限流。
PUBLIC_DEMO_MODE=false
PUBLIC_DEMO_CHAT_REQUESTS_PER_MINUTE=12
# 仅在反向代理会正确覆盖 X-Forwarded-For 时开启。
TRUST_PROXY_HEADERS=false
TOOL_TIMEOUT_SECONDS=12
AMAP_TOOL_TIMEOUT_SECONDS=20
AMAP_MAX_CONCURRENCY=4
TOOL_MAX_CONCURRENCY=3
CHAT_MAX_TOOL_CALLS=6
# 仅部署环境保存；为空时 /api/e2e/cleanup 保持不可用。
E2E_CLEANUP_SECRET=

# ===== P6 外置只读候选证据 =====
# 默认全部留空，/api/evidence/latest 继续返回仓库内历史 evidence。
# 候选部署时前四项必须同时配置；Candidate Gate=PASS 时后两项也必须配置。
# 三个文件必须位于仓库外，并以只读方式挂载；hash 是文件原始 bytes 的 SHA-256。
# CANDIDATE_EVIDENCE_PATH=/run/breezetravel-evidence/candidate-evidence.json
# CANDIDATE_EVIDENCE_SHA256=
# CANDIDATE_RELEASE_MANIFEST_PATH=/run/breezetravel-evidence/release-manifest.json
# CANDIDATE_RELEASE_MANIFEST_SHA256=
# CANDIDATE_GATE_RECEIPT_PATH=/run/breezetravel-evidence/candidate-gate-receipt.json
# CANDIDATE_GATE_RECEIPT_SHA256=

# ===== CORS（生产环境部署时按需修改）=====
# 允许跨域访问的前端 Origin 正则，默认只放行 localhost
# 部署到 Vercel 后改为（替换 your-app 为实际子域）：
# CORS_ORIGIN_REGEX=^https://(your-app\.vercel\.app|localhost(:\d+)?)$

# ===== Docker 镜像加速（国内网络拉取超时时启用）=====
# Y_WEBSOCKET_NODE_IMAGE=docker.1ms.run/library/node:18-alpine
# BACKEND_PYTHON_IMAGE=docker.1ms.run/library/python:3.11-alpine
# POSTGRES_IMAGE=docker.1ms.run/pgvector/pgvector:pg16
# REDIS_IMAGE=docker.1ms.run/library/redis:7-alpine
